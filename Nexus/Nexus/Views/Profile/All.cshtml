@model IEnumerable<Nexus.ViewModels.Profile.ProfileViewModel>

@{
    ViewData["Title"] = "Profiles";
}

@section Styles {
    <style>
        .badge-connection {
            background-color: DarkCyan;
            color: #fff;
            border-radius: 0.2rem;
            padding: 0.35rem 0.6rem;
            font-weight: 600;
        }
    </style>
}

<div class="page-wrapper">
    <div class="container my-5">
        <div class="card shadow-sm bg-white text-dark">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="mb-0">All Profiles</h2>

                    <div class="w-50">
                        <input id="profileSearch" class="form-control rounded-pill" placeholder="Search by name, city or interest..." />
                    </div>
                </div>

                <div class="row g-4">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var p in Model)
                        {
                            var interestsText = string.Join(", ", p.Interests ?? Enumerable.Empty<string>());
                            var connectionText = p.DesiredConnection.ToString() ?? string.Empty;
                            <div class="col-12 col-sm-6 col-lg-4 profile-card">
                                <div class="card h-100 shadow-sm bg-white text-dark">
                                    <div class="card-body d-flex flex-column">
                                        <h5 class="card-title mb-1">@p.DisplayName</h5>
                                        <div class="text-muted small mb-2">@p.Age years • @p.City</div>

                                        <span class="badge-connection mb-2">@connectionText</span>

                                        <p class="card-text text-truncate" title="@interestsText">
                                            <strong>Interests:</strong> @interestsText
                                        </p>

                                        <div class="mt-auto d-flex justify-content-end gap-2">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#profileDetailsModal"
                                                    data-name="@p.DisplayName"
                                                    data-age="@p.Age"
                                                    data-city="@p.City"
                                                    data-connection="@connectionText"
                                                    data-interests="@interestsText"
                                                    data-bio="@(p.Bio ?? string.Empty)">
                                                Details
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12">
                            <div class="alert alert-info mb-0">No profiles found.</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="profileDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-dark bg-white">
            <div class="modal-header">
                <h5 class="modal-title" id="profileDetailsTitle">Profile details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8" id="detailName"></dd>

                    <dt class="col-sm-4">Age</dt>
                    <dd class="col-sm-8" id="detailAge"></dd>

                    <dt class="col-sm-4">City</dt>
                    <dd class="col-sm-8" id="detailCity"></dd>

                    <dt class="col-sm-4">Connection</dt>
                    <dd class="col-sm-8" id="detailConnection"></dd>

                    <dt class="col-sm-4">Interests</dt>
                    <dd class="col-sm-8" id="detailInterests"></dd>

                    <dt class="col-sm-4">Biography</dt>
                    <dd class="col-sm-8" id="detailBio"></dd>
                </dl>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const searchInput = document.getElementById('profileSearch');
            const cards = Array.from(document.querySelectorAll('.profile-card'));

            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    const q = this.value.trim().toLowerCase();
                    cards.forEach(card => {
                        const text = card.innerText.toLowerCase();
                        card.style.display = q === '' || text.indexOf(q) >= 0 ? '' : 'none';
                    });
                });
            }

            const modal = document.getElementById('profileDetailsModal');
            if (modal) {
                modal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    if (!button) return;

                    const set = (id, attr) => {
                        const el = document.getElementById(id);
                        if (el) el.innerText = button.getAttribute(attr) || '';
                    };

                    set('profileDetailsTitle', 'data-name');
                    set('detailName', 'data-name');
                    set('detailAge', 'data-age');
                    set('detailCity', 'data-city');
                    set('detailConnection', 'data-connection');
                    set('detailInterests', 'data-interests');
                    set('detailBio', 'data-bio');
                });
            }
        })();
    </script>
}

