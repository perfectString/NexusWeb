@using Nexus.GCommon.Enums
@model Nexus.ViewModels.Profile.ProfileEditViewModel

@{
    ViewData["Title"] = "Edit profile";
    var _availableInterestsJson = System.Text.Json.JsonSerializer.Serialize(
        Model.AvailableInterests.Select(i => new { i.Id, i.Name })
    );
    var _initialSelectedIds = System.Text.Json.JsonSerializer.Serialize(Model.InterestId ?? new List<int>());
}

@section Styles {
    <style>
        .profile-edit-wrap {
            margin-top: 0.5rem;
        }

        .profile-glass {
            background: #fff;
            color: #2b2548;
            border-radius: 0.75rem;
            padding: 1.25rem;
            box-shadow: 0 2px 12px rgba(43,37,72,0.08);
        }

        .muted-small { color:#7e789c; font-size:.95rem; }

        .interests-wrap {
            display:flex;
            flex-direction:column;
            gap:.5rem;
            max-width:720px;
        }

        .interest-search {
            display:flex;
            gap:.5rem;
            align-items:center;
        }

        .interest-search input {
            flex:1;
            padding:.45rem .6rem;
            border-radius:.5rem;
            border:1px solid #d5d1e8;
            font-size:.95rem;
        }

        .interest-search input:focus {
            border-color: #4e41be;
            outline: none;
            box-shadow: 0 0 0 0.2rem rgba(78,65,190,0.15);
        }

        .interest-grid {
            display:flex;
            flex-wrap:wrap;
            gap:.5rem;
            padding:.5rem;
            border-radius:.5rem;
            border:1px solid #d5d1e8;
            background:#fff;
            max-height:220px;
            overflow:auto;
        }

        .interest-card {
            display:inline-flex;
            align-items:center;
            gap:.5rem;
            padding:.35rem .6rem;
            border-radius:999px;
            background:#f4f2fb;
            color:#4e41be;
            font-weight:600;
            font-size:.9rem;
            border:1px solid rgba(78,65,190,0.08);
            cursor:pointer;
            user-select:none;
            transition: background 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
        }

        .interest-card:hover {
            background: #e8e5f5;
        }

        .interest-card.selected {
            background: linear-gradient(90deg, #d4a017, #f0c040);
            color: #3a2800;
            border-color: rgba(212,160,23,0.2);
            box-shadow: 0 2px 8px rgba(212,160,23,0.2);
        }

        .interest-card.selected:hover {
            background: linear-gradient(90deg, #c49315, #e6b535);
        }

        .interest-count {
            font-size:.85rem;
            color:#7e789c;
        }

        .form-actions {
            display:flex;
            gap:.6rem;
            justify-content:flex-end;
            align-items:center;
        }

        @@media (min-width: 992px) {
            .profile-edit-wrap { margin-top: 1rem; }
        }
    </style>
}

<div class="container my-4">
    <div class="profile-edit-wrap">
        <div class="profile-glass">
            <h4 class="mb-3">Edit profile</h4>

            <form asp-action="Edit" method="post" class="row g-3">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <div class="col-12 col-md-6">
                    <label asp-for="DisplayName" class="form-label"></label>
                    <input asp-for="DisplayName" class="form-control form-control-lg" />
                    <span asp-validation-for="DisplayName" class="text-danger small"></span>
                </div>

                <div class="col-6 col-md-3">
                    <label asp-for="Age" class="form-label"></label>
                    <input asp-for="Age" type="number" class="form-control" min="0" />
                    <span asp-validation-for="Age" class="text-danger small"></span>
                </div>

                <div class="col-6 col-md-3">
                    <label asp-for="City" class="form-label"></label>
                    <input asp-for="City" class="form-control" />
                    <span asp-validation-for="City" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Bio" class="form-label"></label>
                    <textarea asp-for="Bio" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Bio" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="DesiredConnection" class="form-label">Desired connection</label>
                    <select asp-for="DesiredConnection" class="form-select">
                        <option value="">Select</option>
                        @foreach (var v in Enum.GetValues(typeof(Nexus.GCommon.Enums.ConnectionType)))
                        {
                            <option value="@( (int)v )" selected="@(Model.DesiredConnection.Equals(v) ? "selected" : null)">
                                @v
                            </option>
                        }
                    </select>
                    <span asp-validation-for="DesiredConnection" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label class="form-label">Interests</label>

                    <div class="interests-wrap">
                        <div class="interest-search">
                            <input id="interestFilter" type="text" placeholder="Filter interests (shows all results)..." aria-label="Filter interests" />
                            <div class="interest-count" id="interestCount"></div>
                        </div>

                        <div id="interestGrid" class="interest-grid" role="list">
                        </div>
                    </div>

                    <div id="interestHiddenInputs" class="mt-2">
                    </div>

                    <span asp-validation-for="InterestId" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <div class="form-actions">
                        <a asp-action="All" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary btn-lg">Save changes</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const available = @Html.Raw(_availableInterestsJson); //using json serialised against attacks
            const initialSelectedIds = @Html.Raw(_initialSelectedIds); 

            const grid = document.getElementById('interestGrid');
            const filter = document.getElementById('interestFilter');
            const hiddenInputs = document.getElementById('interestHiddenInputs');
            const countEl = document.getElementById('interestCount');

            let selected = [];

            function renderAll() {
                grid.innerHTML = '';
                for (const item of available) {
                    const card = document.createElement('div');
                    card.className = 'interest-card';
                    card.setAttribute('role', 'button');
                    card.setAttribute('data-id', item.Id);
                    card.tabIndex = 0;
                    card.innerText = item.Name;

                    card.addEventListener('click', function () {
                        toggleSelect(item.Id, item.Name, card);
                    });

                    card.addEventListener('keydown', function (e) {
                        if (e.key === 'Enter' || e.key === ' ') {
                            e.preventDefault();
                            toggleSelect(item.Id, item.Name, card);
                        }
                    });

                    grid.appendChild(card);
                }
                updateCount();
            }

            function updateCount() {
                countEl.textContent = `${selected.length}/3 selected`;
            }

            function toggleSelect(id, name, cardEl) {
                const idx = selected.indexOf(id);
                if (idx === -1) {
                    if (selected.length >= 3) {
                        cardEl.animate([{ transform: 'scale(1)' }, { transform: 'scale(0.98)' }, { transform: 'scale(1)' }], { duration: 180 });
                        return;
                    }
                    selected.push(id);
                    cardEl.classList.add('selected');
                } else {
                    selected.splice(idx, 1);
                    cardEl.classList.remove('selected');
                }
                updateHiddenInputs();
                updateCount();
            }

            function updateHiddenInputs() {
                hiddenInputs.innerHTML = '';
                for (const id of selected) {
                    const inputEl = document.createElement('input');
                    inputEl.type = 'hidden';
                    inputEl.name = 'InterestId';
                    inputEl.value = id;
                    hiddenInputs.appendChild(inputEl);
                }
            }

            function initSelected() {
                if (!Array.isArray(initialSelectedIds)) return;
                for (const id of initialSelectedIds) {
                    const card = grid.querySelector(`.interest-card[data-id="${id}"]`);
                    if (card) {
                        selected.push(id);
                        card.classList.add('selected');
                    }
                }
                updateHiddenInputs();
                updateCount();
            }

            function applyFilter(q) {
                const ql = (q || '').trim().toLowerCase();
                const cards = Array.from(grid.children);
                let visible = 0;
                for (const c of cards) {
                    const text = c.textContent.toLowerCase();
                    const show = ql === '' || text.includes(ql);
                    c.style.display = show ? '' : 'none';
                    if (show) visible++;
                }

                const total = available.length;
                countEl.textContent = `${selected.length}/3 selected • ${visible} / ${total} visible`;
            }

            filter.addEventListener('input', function () {
                applyFilter(this.value);
            });

            renderAll();
            initSelected();

            window.__interestGrid = {
                selected() { return selected.slice(); },
                selectAll() { available.forEach(a => { const el = grid.querySelector(`.interest-card[data-id="${a.Id}"]`); if (el && !selected.includes(a.Id) && selected.length < 3) toggleSelect(a.Id, a.Name, el); }); }
            };
        })();
    </script>
}
