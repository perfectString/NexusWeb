@using System.Security.Claims
@model IEnumerable<Nexus.ViewModels.Quest.QuestViewModel>

@{
    ViewData["Title"] = "Quests";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

@section Styles {
    <style>
        .mb-3 {
            color: ghostwhite;
        }
    </style>
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">Quests</h3>
        <a asp-action="Add" class="btn btn-sm btn-primary">New Quest</a>
    </div>

    <div class="mb-3">
        <input id="questSearch" class="form-control" placeholder="Search title, description or initiator..." />
    </div>

    <div class="row g-3">
        @if (Model != null && Model.Any())
        {
            foreach (var q in Model)
            {
                var isInitiator = !string.IsNullOrEmpty(currentUserId) && currentUserId == q.InitiatorId;
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@q.Title</h5>
                            <h6 class="card-subtitle mb-2 text-muted small">By @q.QuestInitiator</h6>
                            <p class="card-text text-truncate" title="@q.Description">@q.Description</p>

                            <div class="mt-auto d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@q.Id" class="btn btn-sm btn-outline-primary">Details</a>

                                @if (isInitiator)
                                {
                                    <a asp-action="Edit" asp-route-id="@q.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                    <a asp-action="Edit" asp-route-id="@q.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                }
                                else
                                {
                                    <form asp-action="Joined" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@q.Id" />
                                        <button type="submit" class="btn btn-sm btn-primary">Join</button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info mb-0">No quests found.</div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const input = document.getElementById('questSearch');
            if (!input) return;
            input.addEventListener('input', function () {
                const q = this.value.trim().toLowerCase();
                document.querySelectorAll('.row.g-3 > .col-12, .row.g-3 > .col-md-6').forEach(col => {
                    const text = col.innerText.toLowerCase();
                    col.style.display = q === '' || text.indexOf(q) >= 0 ? '' : 'none';
                });
            });
        })();
    </script>
}
