@model Nexus.ViewModels.Quest.QuestDetailsViewModel
@using System.Security.Claims

@{
    Layout = "_Layout";
    ViewData["Title"] = Model?.Title ?? "Quest details";
}

@section Styles {
    <style>
        .quest-card { background: #fff; color: #2b2548; }
        .joined-card { background: #f4f2fb; color: #2b2548; border-radius: 8px; }
        .badge-initiator { background-color: #4e41be; color: #fff; border-radius: .375rem; padding: .25rem .5rem; }
        .quest-interest {
            display:inline-block; background:#f4f2fb; color:#4e41be;
            padding:.32rem .55rem; border-radius:999px; font-weight:600;
            font-size:.85rem; border:1px solid rgba(78,65,190,0.08);
            margin:.2rem .3rem .2rem 0;
        }
        #joinedUsers .card { min-height: 100%; }
        #joinedUsers .card-body { display:flex; align-items:center; gap:.75rem; }
    </style>
}

<div class="container my-4">
    <div class="card quest-card shadow-sm">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12 col-lg-8">
                    <h3 class="mb-1">@Model!.Title</h3>
                    <div class="mb-2">
                        <span class="badge badge-initiator me-2">Initiator: @Model.QuestInitiator</span>
                        <span class="text-muted small">@(@Model.JoinedProfiles?.Count ?? 0) Current participants</span>
                    </div>

                    @if (Model.Interests != null && Model.Interests.Any())
                    {
                        <div class="mb-3">
                            @foreach (var interest in Model.Interests)
                            {
                                <span class="quest-interest">@interest</span>
                            }
                        </div>
                    }

                    <p class="mb-3">@Model.Description</p>

                    <div class="d-flex gap-2">
                        <a asp-action="All" asp-controller="Quest" class="btn btn-outline-secondary btn-sm">Back to quests</a>

                        @if (Model != null)
                        {
                            var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
                            var isInitiator = !string.IsNullOrEmpty(currentUserId) && currentUserId == Model.InitiatorId.ToString();
                            if (isInitiator)
                            {
                                if (Model.Status == Nexus.GCommon.Enums.QuestStatus.Active)
                                {
                                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">Edit</a>

                                    <form asp-action="Complete" method="post" class="d-inline-block m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@Model.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-success">Mark Completed</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">Quest completed</span>
                                }
                            }
                        }
                    </div>
                </div>

                <div class="col-12 col-lg-4">
                    <div class="card h-100 border-0">
                        <div class="card-body">
                            <h6 class="card-title mb-3">Joined people</h6>

                            @if (Model.JoinedProfiles != null && Model.JoinedProfiles.Any())
                            {
                                <div id="joinedUsers" class="row g-2">
                                    @foreach (var profile in Model.JoinedProfiles)
                                    {
                                        <div class="col-12">
                                            <div class="card joined-card shadow-sm mt-2">
                                                <div class="card-body d-flex align-items-center gap-3">
                                                    <div class="flex-grow-1">
                                                        <div class="fw-semibold">@profile.DisplayName</div>
                                                        <div class="text-muted small">@profile.City • @profile.Age</div>
                                                        @if (profile.Interests != null && profile.Interests.Any())
                                                        {
                                                            <div class="text-muted small text-truncate" title="@string.Join(", ", profile.Interests)">
                                                                <strong>Interests:</strong> @string.Join(", ", profile.Interests)
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info mb-0">No one has joined this quest yet.</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

