@model Nexus.ViewModels.Quest.QuestAddViewModel
@using Nexus.GCommon.Enums
@using Nexus.Data.Services.Core.Helpers

@{
    ViewData["Title"] = "Edit Quest";

    var diffClass = Model.Difficulty == Nexus.GCommon.Enums.QuestDifficulty.Easy ? "diff-easy"
                  : Model.Difficulty == Nexus.GCommon.Enums.QuestDifficulty.Medium ? "diff-medium"
                  : "diff-hard";

    var rewardXp = QuestRewardHelper.GetRewardXp(Model.Difficulty);
}

<div class="container my-4">
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h4 class="mb-0">Edit Quest</h4>
        </div>

        <div class="card-body">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="row g-3">
                @Html.AntiForgeryToken()

                <input asp-for="Id" type="hidden" />
                <input asp-for="Difficulty" type="hidden" />

                <div class="col-12">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="col-12 col-lg-6">
                    <label class="form-label">Difficulty</label>
                    <div>
                        <span class="badge-difficulty @diffClass">@Model.Difficulty</span>
                        <small class="text-muted ms-2">Difficulty is locked after creation.</small>
                    </div>
                </div>

                <div class="col-12 col-lg-6">
                    <label class="form-label">Reward XP</label>
                    <input class="form-control" value="@($"{rewardXp} XP")" readonly />
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="6"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="col-12 d-flex justify-content-end gap-2">
                    <a asp-action="All" class="btn btn-outline-secondary">Back</a>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>

            <hr />

            <form asp-action="DeleteConfirm" asp-route-id="@Model.Id" method="post"
                  class="mt-3"
                  onsubmit="return confirm('Delete this quest? This action cannot be undone.');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">Delete Quest</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}