@model Nexus.ViewModels.Quest.QuestAddViewModel
@using Nexus.GCommon.Enums
@using Nexus.Data.Services.Core.Helpers
@using Nexus.Web.Infrastructure.Utilities.Interfaces
@inject ISlugGenerator SlugGenerator

@{
    ViewData["Title"] = "Edit Quest";

    var diffClass = Model.Difficulty == Nexus.GCommon.Enums.QuestDifficulty.Easy ? "diff-easy"
                  : Model.Difficulty == Nexus.GCommon.Enums.QuestDifficulty.Medium ? "diff-medium"
                  : "diff-hard";

    var rewardXp = QuestRewardHelper.GetRewardXp(Model.Difficulty);

    var selectedInterests = Model.AvailableInterests
        .Where(i => Model.InterestIds.Contains(i.Id))
        .ToList();
}

@section Styles {
    <style>
        .interest-locked {
            display:inline-flex; align-items:center; padding:.35rem .6rem;
            border-radius:999px; font-weight:600; font-size:.9rem;
            background: linear-gradient(90deg, #d4a017, #f0c040);
            color:#3a2800; border:1px solid rgba(212,160,23,0.2);
            margin:.2rem .3rem .2rem 0;
        }

        .create-quest-card { max-width: 900px; margin: 0 auto; margin-bottom: 5rem; }

        .interest-grid {
            display:flex; flex-wrap:wrap; gap:.5rem; padding:.5rem;
            border-radius:.5rem; border:1px solid #d5d1e8;
            background:#fff; max-height:110px; overflow:auto;
        }

        .quest-edit-note {
            background: #fffbe6;
            border-color: #ffe58f;
            color: #7a5c00;
            border-radius: 0.5rem;
            font-size: 1rem;
            margin-bottom: 0;
            padding: 0.5rem 1.1rem;
            border: 1px solid #ffe58f;
            display: inline-block;
            min-width: 727px;
        }
    </style>
}

<div class="container my-4">
    <div class="card shadow-sm create-quest-card">
        <div class="card-header bg-white">
            <h4 class="mb-0">Edit Quest</h4>
        </div>

        <div class="card-body">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="row g-3">
                @Html.AntiForgeryToken()

                <input asp-for="Id" type="hidden" />
                <input asp-for="Difficulty" type="hidden" />

                @foreach (var id in Model.InterestIds)
                {
                    <input type="hidden" name="InterestIds" value="@id" />
                }

                <div class="col-12">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="col-12 col-lg-6">
                    <label class="form-label">Difficulty</label>
                    <div>
                        <span class="badge-difficulty @diffClass">@Model.Difficulty</span>
                        <small class="text-muted ms-2">Difficulty is locked after creation.</small>
                    </div>
                </div>

                <div class="col-12 col-lg-6">
                    <label class="form-label">Reward XP</label>
                    <input class="form-control" value="@($"{rewardXp} XP")" readonly />
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4" maxlength="@Nexus.GCommon.ValidationConstants.DescriptionMaxLen" id="descriptionInput"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label class="form-label">Interests</label>
                    @if (selectedInterests.Any())
                    {
                        <div>
                            @foreach (var interest in selectedInterests)
                            {
                                <span class="interest-locked">@interest.Name</span>
                            }
                            <div class="mt-1">
                                <small class="text-muted">Interests are locked after creation.</small>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted small">No interests selected. Interests are locked after creation.</div>
                    }
                </div>

                <div class="col-12 d-flex justify-content-end gap-2">
                    <a asp-action="All" class="btn btn-outline-secondary">Back</a>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>

            <hr />

            <div class="d-flex align-items-center gap-3 mt-3 flex-wrap">
                <form asp-action="DeleteConfirm" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirm('Delete this quest? This action cannot be undone.');" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger">Delete Quest</button>
                </form>
                <div class="alert alert-warning mb-0 py-2 px-3 quest-edit-note">
                    <strong>Note:</strong> Contact site administrator if you'd like difficulty or interests changed.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}