@using System
@using System.Linq
@using System.Text.Json
@using Nexus.Data.Services.Core.Helpers
@model Nexus.ViewModels.Quest.QuestAddViewModel

@{
    ViewData["Title"] = "Add Quest";

    var difficultyValues = Enum.GetValues(typeof(Nexus.GCommon.Enums.QuestDifficulty))
        .Cast<Nexus.GCommon.Enums.QuestDifficulty>()
        .ToList();

    var rewardMap = difficultyValues
        .ToDictionary(d => d.ToString(), d => QuestRewardHelper.GetRewardXp(d));

    var initialReward = rewardMap.ContainsKey(Model.Difficulty.ToString())
        ? rewardMap[Model.Difficulty.ToString()]
        : rewardMap.First().Value;

    var availableInterestsJson = JsonSerializer.Serialize(
        Model.AvailableInterests.Select(i => new { i.Id, i.Name })
    );
    var initialSelectedIds = JsonSerializer.Serialize(Model.InterestIds ?? new List<int>());
}

@section Styles {
    <style>
        .create-quest-card { max-width: 960px; margin: 0 auto; }
        .meta-row { display:flex; gap:0.75rem; align-items:center; flex-wrap:wrap; color:#6c757d; font-size:.9rem; }
        .reward-badge {
            background: linear-gradient(90deg,#fff7e6,#fff0d9);
            color:#7a4a00;
            padding:.22rem .6rem;
            border-radius:999px;
            font-weight:700;
            font-size:.9rem;
            border: 1px solid rgba(78,65,190,0.08);
            white-space:nowrap;
        }
        .form-section { padding:1rem; }
        .form-actions { display:flex; justify-content:flex-end; gap:.5rem; }

        .interest-grid {
            display:flex; flex-wrap:wrap; gap:.5rem; padding:.5rem;
            border-radius:.5rem; border:1px solid #d5d1e8;
            background:#fff;
        }
        .interest-card {
            display:inline-flex; align-items:center; padding:.35rem .6rem;
            border-radius:999px; background:#f4f2fb; color:#4e41be;
            font-weight:600; font-size:.9rem; border:1px solid rgba(78,65,190,0.08);
            cursor:pointer; user-select:none;
            transition: background 0.15s ease, color 0.15s ease;
        }
        .interest-card:hover { background:#e8e5f5; }
        .interest-card.selected {
            background: linear-gradient(90deg, #d4a017, #f0c040);
            color:#3a2800; border-color:rgba(212,160,23,0.2);
            box-shadow: 0 2px 8px rgba(212,160,23,0.2);
        }
        .interest-card.selected:hover { background: linear-gradient(90deg, #c49315, #e6b535); }
        .interest-count { font-size:.85rem; color:#7e789c; }
    </style>
}

<div class="container my-4">
    <div class="card shadow-sm create-quest-card">
        <div class="card-header bg-white d-flex align-items-center justify-content-between">
            <div>
                <h4 class="mb-0">Create Quest</h4>
                <div class="meta-row mt-1">
                    <span class="text-muted">Create a quest to complete with others</span>
                </div>
            </div>

            <div class="d-flex align-items-center gap-3">
                <div class="text-muted small">Reward preview</div>
                <div id="addRewardBadge" class="reward-badge">@($"{initialReward} XP")</div>
            </div>
        </div>

        <div class="card-body form-section">
            <form asp-action="Add" method="post" class="row g-3">
                @Html.AntiForgeryToken()

                <div class="col-12">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                </div>

                <div class="col-12">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="col-12 col-lg-6">
                    <label asp-for="Difficulty" class="form-label d-block"></label>
                    <div class="d-flex gap-2 align-items-center">
                        <select asp-for="Difficulty" class="form-select" id="difficultySelect" style="min-width:180px;">
                            @foreach (var d in difficultyValues)
                            {
                                <option value="@d" @@(Model.Difficulty == d ? "selected" : "")>@d</option>
                            }
                        </select>

                        <div class="form-text small text-muted ms-2">Difficulty locked after creation</div>
                    </div>
                    <span asp-validation-for="Difficulty" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="6" maxlength="@Nexus.GCommon.ValidationConstants.DescriptionMaxLen" id="descriptionInput"></textarea>
                    <div class="d-flex justify-content-between mt-1">
                        <span>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </span>
                        <small id="descCount" class="text-muted small">0/@Nexus.GCommon.ValidationConstants.DescriptionMaxLen</small>
                    </div>
                </div>

                <div class="col-12">
                    <label class="form-label">
                        Interests <span class="text-muted small">(Interests locked after creation)</span>
                        <span class="interest-count ms-2" id="questInterestCount"></span>
                    </label>
                    <div id="questInterestGrid" class="interest-grid" role="list"></div>
                    <div id="questInterestHiddenInputs" class="mt-2"></div>
                </div>

                <div class="col-12 form-actions">
                    <a asp-action="All" class="btn btn-outline-secondary">Back</a>
                    <button type="submit" class="btn btn-primary">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const textarea = document.getElementById('descriptionInput');
            const counter = document.getElementById('descCount');
            const max = Number('@Nexus.GCommon.ValidationConstants.DescriptionMaxLen');

            function updateCount() {
                const len = textarea ? textarea.value.length : 0;
                if (counter) counter.innerText = len + '/' + max;
            }

            if (textarea) {
                updateCount();
                textarea.addEventListener('input', updateCount);
            }

            const rewardMap = @Html.Raw(JsonSerializer.Serialize(rewardMap)); //using json serialised against attacks
            const difficultySelect = document.getElementById('difficultySelect');
            const rewardBadge = document.getElementById('addRewardBadge');

            function updateReward() {
                if (!difficultySelect || !rewardBadge) return;
                const key = difficultySelect.value;
                const xp = (rewardMap && rewardMap[key]) ? rewardMap[key] : null;
                rewardBadge.innerText = xp ? `${xp} XP` : '';
            }

            if (difficultySelect) {
                difficultySelect.addEventListener('change', updateReward);
                updateReward();
            }


            const available = @Html.Raw(availableInterestsJson); //using json serialised against attacks
            const initialSelected = @Html.Raw(initialSelectedIds);
            const grid = document.getElementById('questInterestGrid');
            const hiddenInputs = document.getElementById('questInterestHiddenInputs');
            const countEl = document.getElementById('questInterestCount');
            let selected = [];

            function renderAll() {
                grid.innerHTML = '';
                for (const item of available) {
                    const card = document.createElement('div');
                    card.className = 'interest-card';
                    card.setAttribute('role', 'button');
                    card.setAttribute('data-id', item.Id);
                    card.tabIndex = 0;
                    card.innerText = item.Name;
                    card.addEventListener('click', () => toggleSelect(item.Id, card));
                    card.addEventListener('keydown', (e) => {
                        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggleSelect(item.Id, card); }
                    });
                    grid.appendChild(card);
                }
                updateCountDisplay();
            }

            function updateCountDisplay() {
                countEl.textContent = `${selected.length}/3 selected`;
            }

            function toggleSelect(id, cardEl) {
                const idx = selected.indexOf(id);
                if (idx === -1) {
                    if (selected.length >= 3) {
                        cardEl.animate([{ transform: 'scale(1)' }, { transform: 'scale(0.98)' }, { transform: 'scale(1)' }], { duration: 180 });
                        return;
                    }
                    selected.push(id);
                    cardEl.classList.add('selected');
                } else {
                    selected.splice(idx, 1);
                    cardEl.classList.remove('selected');
                }
                updateHiddenInputs();
                updateCountDisplay();
            }

            function updateHiddenInputs() {
                hiddenInputs.innerHTML = '';
                for (const id of selected) {
                    const inp = document.createElement('input');
                    inp.type = 'hidden';
                    inp.name = 'InterestIds';
                    inp.value = id;
                    hiddenInputs.appendChild(inp);
                }
            }

            function initSelected() {
                if (!Array.isArray(initialSelected)) return;
                for (const id of initialSelected) {
                    const card = grid.querySelector(`.interest-card[data-id="${id}"]`);
                    if (card) { selected.push(id); card.classList.add('selected'); }
                }
                updateHiddenInputs();
                updateCountDisplay();
            }

            renderAll();
            initSelected();
        })();
    </script>
}
