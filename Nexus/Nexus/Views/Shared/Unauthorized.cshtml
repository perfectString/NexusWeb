@{
    ViewData["Title"] = "Unauthorized";
}

@section Styles {
    <style>
        .unauth-container {
            max-width: 520px;
            margin: 5rem auto 0 auto;
            padding: 2.5rem 2rem;
            background: #fff;
            border-radius: 0.75rem;
            box-shadow: 0 2px 12px rgba(78,65,190,0.10);
            text-align: center;
        }

        .unauth-title {
            font-size: 2.2rem;
            font-weight: 800;
            color: #b83243;
            margin-bottom: 0.5rem;
            letter-spacing: 0.04em;
        }

        .unauth-desc {
            color: #7e789c;
            font-size: 1.08rem;
            margin-bottom: 2rem;
        }

        .unauth-btn {
            padding: 0.7rem 2.1rem;
            font-size: 1.08rem;
            border-radius: 999px;
            font-weight: 600;
        }
    </style>
}

<div class="unauth-container">
    <div class="unauth-title">Error 401: Unauthorized</div>
    <div class="unauth-desc">
        You do not have permission to access this page.<br>
    </div>
    <a href="@(Url.Action("Index", "Home"))" class="btn btn-primary unauth-btn">
        Go Home
    </a>
</div>