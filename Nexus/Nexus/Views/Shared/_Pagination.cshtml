@{
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    string controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
}

@if (totalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center mt-3 mb-0" style="gap:.35rem;">
            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                <a class="page-link pagination-link" asp-action="@action" asp-controller="@controller" asp-route-page="@(currentPage - 1)">
                   Prev 
                </a>
            </li>

            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link pagination-link" asp-action="@action" asp-controller="@controller" asp-route-page="@i">@i</a>
                </li>
            }

            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                <a class="page-link pagination-link" asp-action="@action" asp-controller="@controller" asp-route-page="@(currentPage + 1)">
                    Next
                </a>
            </li>
        </ul>
    </nav>

   
}