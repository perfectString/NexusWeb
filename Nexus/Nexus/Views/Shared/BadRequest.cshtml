
@{
    ViewData["Title"] = "Bad Request";
}

@section Styles {
    <style>
        .badrequest-container {
            max-width: 520px;
            margin: 5rem auto 0 auto;
            padding: 2.5rem 2rem;
            background: #fff;
            border-radius: 0.75rem;
            box-shadow: 0 2px 12px rgba(78,65,190,0.10);
            text-align: center;
        }

        .badrequest-title {
            font-size: 2.2rem;
            font-weight: 800;
            color: #b83243;
            margin-bottom: 0.5rem;
            letter-spacing: 0.04em;
        }

        .badrequest-desc {
            color: #7e789c;
            font-size: 1.08rem;
            margin-bottom: 2rem;
        }

        .badrequest-btn {
            padding: 0.7rem 2.1rem;
            font-size: 1.08rem;
            border-radius: 999px;
            font-weight: 600;
        }
    </style>
}

<div class="badrequest-container">
    <div class="badrequest-title">Error 400: Bad Request</div>
    <div class="badrequest-desc">
        The request was invalid or cannot be processed.<br>
        Please check your input or try again from the homepage.
    </div>
    <a href="@(Url.Action("Index", "Home"))" class="btn btn-primary badrequest-btn">
        Go Home
    </a>
</div>