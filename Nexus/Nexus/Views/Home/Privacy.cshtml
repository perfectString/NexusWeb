@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-7">
        <div class="card p-4 p-md-5" style="border-radius: 0.75rem; box-shadow: 0 2px 12px rgba(43,37,72,0.08);">
            <h1 class="h3 fw-bold mb-4">@ViewData["Title"]</h1>

            <p>
                Nexus respects your privacy. This application collects basic account information
                such as your email and username to provide core functionality, including
                authentication and participation in activities.
            </p>

            <p>
                Your data is used only for educational and demonstration purposes within this
                project and is not shared with third parties.
            </p>

            <p>
                We take reasonable steps to protect your information and ensure it is used
                appropriately.
            </p>

            <p class="mb-0">
                If you have questions about this policy, please contact the site administrator.
            </p>

            <hr class="my-4" />

            <p class="text-muted mb-0" style="font-size: 0.875rem;">
                Last updated: 24th of March 2026
            </p>
        </div>
    </div>
</div>