@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">
    <div class="col-lg-8 mx-auto text-white">

        <h1 class="mb-4">@ViewData["Title"]</h1>

        <p>
            Nexus respects your privacy.
         <br>
            <br>
            This application collects basic account information such as your email and username
            to provide core functionality, including authentication and participation in activities.
