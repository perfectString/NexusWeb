@{
    ViewData["Title"] = "Home Page";
}

@section Styles {
    <style>
        .web-description{
            font-size: 1.4rem;
            font-weight: 300;
        }
    </style>
}

<div class="d-flex justify-content-center align-items-start flex-grow-1 pt-5">
    <div class="text-center text-white">
    <h1 class="display-2">Welcome to Nexus!</h1>
    <p class="mt-3">
        <p class="web-description mt-3">
            Nexus connects people through shared interests by turning real-life activities into collaborative experiences!
           <br>
           Find your next adventure today!
       </p>

    <hr class="mt-3">
@if (User.Identity?.IsAuthenticated == false)
{

<p mt-3>Please log in or register to continue using the app.</p>

        <div class="mt-3">
    <a asp-area="Identity"
    asp-page="/Account/Login"
                   class="btn btn-secondary btn-lg me-3">
    Login
    </a>

    <a asp-area="Identity"
    asp-page="/Account/Register"
                   class="btn btn-secondary btn-lg me-3">
       Register
    </a>
</div>
}
else
{
            <a asp-controller="Quest" asp-action="All" class="btn btn-secondary btn-lg">Start your next adventure!</a>

}
</div>
</div>
