@{
    ViewData["Title"] = "Admin Dashboard";
}

@section Styles {
    <style>
        .admin-wrap {
            max-width: 820px;
            margin: 0 auto;
        }

        .admin-banner {
            background: linear-gradient(135deg, #4e41be, #6c5ce7);
            border-radius: 0.75rem;
        }

        .admin-banner h1 {
            font-size: 1.5rem;
        }

        .dash-card {
            border-radius: 0.75rem;
            box-shadow: 0 2px 12px rgba(43, 37, 72, 0.08);
            padding: 2.25rem;
            text-decoration: none;
            color: #2b2548;
            display: flex;
            flex-direction: column;
            gap: 0.65rem;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
            height: 100%;
            border: none;
            border-left: 4px solid transparent;
            background: #fff;
        }

        .dash-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(43, 37, 72, 0.12);
            color: #2b2548;
        }

        .dash-card-purple { border-left-color: #6c5ce7; }
        .dash-card-gold   { border-left-color: #f0c040; }
        .dash-card-teal   { border-left-color: #34d399; }

        .dash-title {
            font-weight: 700;
            font-size: 1.25rem;
            margin: 0;
        }

        .dash-card-purple .dash-title { color: #4e41be; }
        .dash-card-gold   .dash-title { color: #b8860b; }
        .dash-card-teal   .dash-title { color: #0d9f6e; }

        .dash-desc {
            color: #7e789c;
            font-size: 0.95rem;
            margin: 0;
        }

        .section-label {
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.30em;
            text-transform: uppercase;
            color: #7e789c;
            margin-bottom: 0.75rem;
            text-align: center;
            margin-top: -27px;
        }

        .btn-home {
            background: linear-gradient(135deg, #4e41be, #6c5ce7);
            color: #fff;
            font-weight: 600;
            font-size: 0.95rem;
            padding: 1.25rem;
            border-radius: 1.75rem;
            border: none;
            transition: box-shadow 0.15s ease, transform 0.15s ease;
        }

        .btn-home:hover {
            box-shadow: 0 6px 20px rgba(78, 65, 190, 0.3);
            transform: translateY(-2px);
            color: #fff;
        }
    </style>
}

<div class="admin-wrap py-5">
    <div class="admin-banner text-white p-4 mb-5 text-center">
        <h1 class="fw-bold mb-1">Admin Dashboard</h1>
        <p class="mb-0" style="color: rgba(255,255,255,0.75);">
            Welcome back, admin!
        </p>
    </div>

    <div class="section-label">Administration</div>
    <div class="d-flex flex-column gap-3 mb-5">
        <a asp-area="Admin" asp-controller="ProfileManagement" asp-action="Index" class="card dash-card dash-card-purple">
            <p class="dash-title">Manage Users</p>
            <p class="dash-desc">Edit or remove user profiles and manage account details.</p>
        </a>

        <a asp-area="Admin" asp-controller="QuestManagement" asp-action="Index" class="card dash-card dash-card-gold">
            <p class="dash-title">Manage Quests</p>
            <p class="dash-desc">Review, edit or delete quests created by users across the platform.</p>
        </a>

        <a asp-area="" asp-controller="Quest" asp-action="Add" class="card dash-card dash-card-teal">
            <p class="dash-title">Create Quest</p>
            <p class="dash-desc">Start a new quest for users to discover and join.</p>
        </a>
    </div>

    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-home d-block text-center w-100">
        Return to Home Page
    </a>
</div>