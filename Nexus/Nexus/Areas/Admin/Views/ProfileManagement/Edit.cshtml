@model Nexus.ViewModels.Admin.Profile.ProfileManagementViewModel

@{
    ViewData["Title"] = "Edit User — " + Model.DisplayName;
}

@section Styles {
    <style>
        .admin-banner {
            background: linear-gradient(135deg, #4e41be, #6c5ce7);
            border-radius: 0.75rem;
        }

        .admin-banner h1 {
            font-size: 1.5rem;
        }

        .admin-edit-card {
            border-radius: 0.75rem;
            box-shadow: 0 2px 12px rgba(43, 37, 72, 0.08);
        }

        .xp-preview {
            background: #f4f2fb;
            border-radius: 0.75rem;
            padding: 1rem 1.25rem;
            border: 1px solid #eee8ff;
        }

        .xp-preview-bar {
            height: 10px;
            background: rgba(78, 65, 190, 0.08);
            border-radius: 999px;
            overflow: hidden;
        }

        .xp-preview-fill {
            height: 100%;
            background: linear-gradient(90deg, #6c5ce7, #4e41be);
            border-radius: 999px;
            transition: width 0.4s ease;
        }

        .level-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            background: linear-gradient(90deg, #d4a017, #f0c040);
            color: #3a2800;
            font-weight: 700;
            font-size: 0.8rem;
            padding: 0.25rem 0.6rem;
            border-radius: 999px;
        }

        .user-avatar-lg {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 1.1rem;
            color: #fff;
            background: linear-gradient(135deg, #4e41be, #6c5ce7);
            flex-shrink: 0;
        }

        .form-actions {
            display: flex;
            gap: 0.6rem;
            align-items: center;
        }

        .form-actions-right {
            margin-left: auto;
        }
    </style>
}

<div class="py-4">
    <div class="admin-banner text-white p-4 mb-4 d-flex align-items-center gap-3">
        <div class="user-avatar-lg">
            @(string.IsNullOrEmpty(Model.DisplayName) ? "U" : Model.DisplayName.Substring(0, 1).ToUpper())
        </div>
        <div>
            <h1 class="fw-bold mb-0">Edit User</h1>
            <p class="mb-0" style="color: rgba(255,255,255,0.75);">
                @Model.DisplayName — @Model.City
            </p>
        </div>
    </div>

    <div class="card admin-edit-card">
        <div class="card-body p-4">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="row g-3">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <input type="hidden" asp-for="Id" />

                <div class="col-12 col-md-6">
                    <label asp-for="DisplayName" class="form-label fw-semibold">Display Name</label>
                    <input asp-for="DisplayName" class="form-control" />
                    <span asp-validation-for="DisplayName" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="City" class="form-label fw-semibold">City</label>
                    <input asp-for="City" class="form-control" />
                    <span asp-validation-for="City" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Bio" class="form-label fw-semibold">Bio</label>
                    <textarea asp-for="Bio" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Bio" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="ExperiencePoints" class="form-label fw-semibold">Experience Points</label>
                    <input asp-for="ExperiencePoints" type="number" class="form-control" min="0" id="xpInput" />
                    <span asp-validation-for="ExperiencePoints" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-8 d-flex align-items-end">
                    <div class="xp-preview flex-grow-1">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="level-pill" id="levelDisplay">Lv @Model.Level</span>
                            <span class="text-muted" style="font-size: 0.82rem;" id="xpProgressText">
                                @Model.XpIntoCurrentLevel / @Model.XpNeededPerLevel XP
                            </span>
                        </div>
                        <div class="xp-preview-bar">
                            <div class="xp-preview-fill" id="xpBar" style="width: @Model.ProgressPercentage%"></div>
                        </div>
                    </div>
                </div>

                <div class="col-12 mt-4">
                    <div class="form-actions">
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-lg">Delete</a>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Cancel</a>

                        <button type="submit" class="btn btn-primary btn-lg form-actions-right">Save Changes</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const xpInput = document.getElementById('xpInput');
            const levelDisplay = document.getElementById('levelDisplay');
            const xpProgressText = document.getElementById('xpProgressText');
            const xpBar = document.getElementById('xpBar');
            const xpPerLevel = @Model.XpNeededPerLevel;

            if (!xpInput) return;

            function updatePreview() {
                const xp = Math.max(0, parseInt(xpInput.value) || 0);
                const level = Math.floor(xp / xpPerLevel) + 1;
                const xpInto = xp % xpPerLevel;
                const pct = (xpInto / xpPerLevel) * 100;

                levelDisplay.textContent = 'Lv ' + level;
                xpProgressText.textContent = xpInto + ' / ' + xpPerLevel + ' XP';
                xpBar.style.width = pct + '%';
            }

            xpInput.addEventListener('input', updatePreview);
        })();
    </script>
}
