@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

@section Styles {
    <style>
        .auth-card {
            border-radius: 0.75rem;
            box-shadow: 0 2px 12px rgba(43, 37, 72, 0.08);
        }

        .form-floating > .form-control {
            border-color: #d5d1e8;
        }

        .form-floating > .form-control:focus {
            border-color: #4e41be;
        }

        .form-floating > label {
            color: #7e789c;
        }
    </style>
}

<div class="row justify-content-center py-4">
    <div class="col-md-6 col-lg-5">
        <div class="card auth-card p-4 p-md-5">
            <h1 class="h3 fw-bold text-center mb-1">Welcome back!</h1>
            <p class="text-muted text-center mb-4">Sign in to your account</p>

            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email">Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                    <label asp-for="Input.Password">Password</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="form-check mb-4">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label asp-for="Input.RememberMe" class="form-check-label">
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>

                <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary mb-3">
                    Log in
                </button>

                <div class="text-center">
                    <span class="text-muted">Don't have an account?</span>
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}